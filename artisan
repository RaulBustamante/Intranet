#!/usr/bin/env php
<?php

/*
|--------------------------------------------------------------------------
| Compatibilidad de version de PHP
|--------------------------------------------------------------------------
|
| Este proyecto corre sobre Laravel 8.83, que fue escrito antes de PHP 8.4.
| PHP 8.4 deprecó los parámetros nullable implícitos (function f(int $a = null)
| ahora exige ?int), asi que el framework y todo vendor/ disparan cientos de
| avisos "Deprecated" al arrancar, antes de que Laravel registre su propio
| manejador de errores. Silenciarlos aqui, antes del autoloader, los apaga
| para siempre en cualquier version de PHP. Ver tambien public/index.php.
|
*/

error_reporting(E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED);

define('LARAVEL_START', microtime(true));

/*
|--------------------------------------------------------------------------
| Register The Auto Loader
|--------------------------------------------------------------------------
|
| Composer provides a convenient, automatically generated class loader
| for our application. We just need to utilize it! We'll require it
| into the script here so that we do not have to worry about the
| loading of any of our classes manually. It's great to relax.
|
*/

require __DIR__.'/vendor/autoload.php';

/*
| Precargar el stack de logging mientras E_DEPRECATED sigue apagado.
|
| Laravel instala su propio manejador de errores y, cuando le llega la primera
| deprecacion, resuelve LogManager para registrarla. Eso autocarga Monolog\Logger
| e Illuminate\Log\Logger, cuyas declaraciones disparan mas deprecaciones ya
| estando dentro del manejador. PHP no re-entra a un manejador de errores, asi
| que esas caen al manejador nativo y se imprimen. Compilarlas aqui, antes,
| evita por completo esa fuga.
*/
class_exists(\Monolog\Logger::class);
class_exists(\Illuminate\Log\Logger::class);
class_exists(\Illuminate\Log\LogManager::class);

$app = require_once __DIR__.'/bootstrap/app.php';

/*
|--------------------------------------------------------------------------
| Run The Artisan Application
|--------------------------------------------------------------------------
|
| When we run the console application, the current CLI command will be
| executed in this console and the response sent back to a terminal
| or another output device for the developers. Here goes nothing!
|
*/

$kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);

$status = $kernel->handle(
    $input = new Symfony\Component\Console\Input\ArgvInput,
    new Symfony\Component\Console\Output\ConsoleOutput
);

/*
|--------------------------------------------------------------------------
| Shutdown The Application
|--------------------------------------------------------------------------
|
| Once Artisan has finished running, we will fire off the shutdown events
| so that any final work may be done by the application before we shut
| down the process. This is the last thing to happen to the request.
|
*/

$kernel->terminate($input, $status);

exit($status);
